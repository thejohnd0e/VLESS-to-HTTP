# Copy to .env and edit. docker compose reads .env automatically.

# Host address the proxy ports are published on. 127.0.0.1 = this machine only.
# Use 0.0.0.0 (all interfaces) or a LAN address only together with PROXY_USER/PROXY_PASS.
BIND_ADDR=127.0.0.1
HTTP_PORT=9000
SOCKS_PORT=1080

# Login for both the HTTP and SOCKS5 proxy (set both or neither).
PROXY_USER=
PROXY_PASS=

# debug | info | warning | error | none. debug/info also log every visited destination.
LOG_LEVEL=warning

# 1 = print the generated config.json at startup (UUID, keys and password masked).
PRINT_CONFIG=0
