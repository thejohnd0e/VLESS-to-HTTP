# Copy to .env and edit. docker compose reads .env automatically.

# Host address the proxy ports are published on. Empty = all interfaces, IPv4 and IPv6
# (every device in the LAN); a LAN address = that network only; 127.0.0.1 = this machine only.
BIND_ADDR=
HTTP_PORT=9000
SOCKS_PORT=1080

# Optional login for both the HTTP and SOCKS5 proxy (set both or neither).
# Useful when the host is reachable from untrusted networks (e.g. a public IP).
PROXY_USER=
PROXY_PASS=

# debug | info | warning | error | none. debug/info also log every visited destination.
LOG_LEVEL=warning

# 1 = print the generated config.json at startup (UUID, keys and password masked).
PRINT_CONFIG=0

# Several vless:// lines in vless.conf = automatic failover between them.
# leastPing = use the fastest working link | random | roundRobin
FAILOVER_STRATEGY=leastPing
# What is requested through the tunnel to check that it works: by the failover probes
# (every PROBE_INTERVAL) and by the Docker healthcheck (every minute). Must answer 2xx/3xx.
PROBE_URL=https://www.gstatic.com/generate_204
PROBE_INTERVAL=1m
